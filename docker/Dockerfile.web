# The web app: static files served by nginx, which also forwards /ws/ to ROS.

# Stage 1: fetch the browser libraries (three.js, urdf-loader, MediaPipe) so the page needs no CDN.
FROM node:22-alpine AS vendor
RUN apk add --no-cache curl
WORKDIR /web
COPY web/package.json web/vendor.sh ./
RUN sh vendor.sh

FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY web/index.html /usr/share/nginx/html/
COPY web/css /usr/share/nginx/html/css
COPY web/js /usr/share/nginx/html/js
COPY --from=vendor /web/vendor /usr/share/nginx/html/vendor
# The same robot description and meshes that ROS uses.
COPY ros/move_the_bot/robot /usr/share/nginx/html/robot
COPY models/builtin /models/builtin
RUN mkdir -p /models/cache
EXPOSE 80
