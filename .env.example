# Copy to .env and change what you need. Everything here is optional.

# --- Language model -----------------------------------------------------------
# Simple commands ("put the apple on the cube") never need a model. Free-form ones do.
# LLM_BACKEND=ollama                      # a local model served by Ollama (default)
# OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
# OLLAMA_URL=http://host.docker.internal:11434   # use the Ollama app on this computer (GPU on a Mac)
# OLLAMA_URL=http://192.168.1.50:11434            # or Ollama on a GPU PC in your network
# OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M        # a larger model for a 16 GB GPU

# LLM_BACKEND=openai                      # any OpenAI-compatible API, e.g. NVIDIA NIM
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=nvapi-...
# OPENAI_MODEL=meta/llama-3.1-8b-instruct

# --- Robot --------------------------------------------------------------------
# HARDWARE=mock                           # mock | isaac | real   (docs/real-hardware.md)
# USB_PORT=/dev/ttyACM0                   # serial port of a real SO-101

# --- Extras -------------------------------------------------------------------
# Object scanner (./run.sh --scan): a webcam photo becomes a 3D object, made by Idol.
# IDOL_BACKEND=demo                       # Idol's public demo on Hugging Face (default, no GPU)
# HF_TOKEN=hf_...                         # optional: a larger daily quota on the demo
# IDOL_BACKEND=remote                     # or a scan server on a GPU PC, see docs/your-own-objects.md
# IDOL_URL=http://192.168.1.50:8001

# ./record-demo.sh switches the GPU PC's AI on (and off: ./record-demo.sh off) over SSH. Needs
# `ai-switch install` on the PC once (docker/ai-switch/ai-switch.sh).
# GPU_PC_SSH=me@192.168.1.50
# GPU_PC_SSH_KEY=~/.ssh/id_ed25519
# REC_URL_OPTIONS=&llmpc=my%20gaming%20PC          # options of the recording page
# IDOL_GAUSSIANS=262144                   # detail: 65536 up to 1048576
# SKETCHFAB_API_KEY=                      # download 3D models for objects that are not built in
# WEB_PORT=8080
