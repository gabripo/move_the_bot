# Copy to .env and change what you need. Everything here is optional.

# --- Language model -----------------------------------------------------------
# Simple commands ("put the apple on the cube") never need a model. Free-form ones do.
# LLM_BACKEND=ollama                      # a local model served by Ollama (default)
# OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
# OLLAMA_URL=http://host.docker.internal:11434   # use the Ollama app on this computer (GPU on a Mac)

# LLM_BACKEND=openai                      # any OpenAI-compatible API, e.g. NVIDIA NIM
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=nvapi-...
# OPENAI_MODEL=meta/llama-3.1-8b-instruct

# --- Robot --------------------------------------------------------------------
# HARDWARE=mock                           # mock | isaac | real   (docs/real-hardware.md)
# USB_PORT=/dev/ttyACM0                   # serial port of a real SO-101

# --- Extras -------------------------------------------------------------------
# SKETCHFAB_API_KEY=                      # download 3D models for objects that are not built in
# WEB_PORT=8080
